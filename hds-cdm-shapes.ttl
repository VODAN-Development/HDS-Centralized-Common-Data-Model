@prefix hds: <https://vodan-development.github.io/HDS-Centralized-Common-Data-Model/hds-cdm.ttl#> .
@prefix shapes: <https://github.com/VODAN-Development/HDS-Centralized-Common-Data-Model#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL expresses the profile's expected value types. All properties are 
# currently optional because no minimum cardinalities are expressed.

shapes:IncidentShape a sh:NodeShape ;
    sh:targetClass hds:Incident ;
    sh:node shapes:PoliticalIncidentShape, shapes:CasualtyIncidentShape,
        shapes:MilitaryIncidentShape ;
    sh:property [
        sh:path hds:involves ;
        sh:class prov:Agent
    ] ;
    sh:property [
        sh:path schema:location ;
        sh:class dcterms:Location ;
        sh:description "An incident may reference geographical locations. Locations are optional and repeatable."@en
    ] ;
    # Load hds-cdm.ttl with the data for the class and scheme checks.
    sh:property [
        sh:path hds:incidentDomain ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:hasValue hds:incidentDomainScheme
        ]
    ] ;
    sh:property [ sh:path hds:reportedBy ; sh:class prov:Agent ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:or ( [ sh:class hds:Report ] [ sh:class dcat:Dataset ] )
    ] ;
    sh:property [ sh:path schema:startDate ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:endDate ; sh:datatype xsd:dateTime ] ;
    sh:property shapes:Description ;
    sh:property [ sh:path hds:confidentiality ; sh:datatype xsd:string ] ;
    sh:property [ sh:path hds:victimCount ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path hds:status ; sh:datatype xsd:string ] .

shapes:AgentShape a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:property [ sh:path hds:actorType ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rdfs:label ; sh:node shapes:TextLiteral ] ;
    sh:property [ sh:path foaf:name ; sh:node shapes:TextLiteral ] .

shapes:CampShape a sh:NodeShape ;
    sh:targetClass hds:Camp ;
    sh:description "Camp instances may reference geographical locations. These are distinct from the class-level links to incident-domain concepts."@en ;
    sh:property [ sh:path schema:location ; sh:class dcterms:Location ] .

shapes:MigrationRouteShape a sh:NodeShape ;
    sh:targetClass hds:MigrationRoute ;
    sh:description "Route instances may reference geographical locations. These are distinct from the class-level links to incident-domain concepts."@en ;
    sh:property [ sh:path schema:location ; sh:class dcterms:Location ] .

shapes:LocationDomainLinksShape a sh:NodeShape ;
    sh:targetNode hds:Camp, hds:MigrationRoute ;
    sh:property [
        sh:path schema:location ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:property [ sh:path skos:inScheme ; sh:hasValue hds:incidentDomainScheme ]
    ] .

# These reusable shapes check field types on every incident, regardless of tag.
# Applicable-property annotations describe relevance, not permission or requiredness.
shapes:PoliticalIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:outcome ; sh:datatype xsd:string ] .

shapes:CasualtyIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:casualties ; sh:datatype xsd:integer ] .

shapes:MilitaryIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:weaponsUsed ; sh:datatype xsd:string ] .

# Consent assignees use the same agent class as other actor references.
shapes:ConsentShape a sh:NodeShape ;
    sh:targetClass dpv:Consent ;
    sh:property [ sh:path odrl:assignee ; sh:class prov:Agent ] ;
    sh:property [ sh:path dcterms:accessRights ; sh:class prov:Agent ] ;
    sh:property [ sh:path dpv:hasPurpose ; sh:class dpv:Purpose ] ;
    sh:property [ sh:path dcterms:publisher ; sh:node shapes:PublisherAgentReference ] .

# All agent roles, including publishers, use the same PROV class.
shapes:PublisherAgentReference a sh:NodeShape ;
    sh:description "Publisher references must be typed as prov:Agent."@en ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node shapes:AgentShape ;
    sh:class prov:Agent .

# License metadata applies to catalogues and datasets.
# Purpose and policy links to governance resources are not part of this profile.
shapes:RightsMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset ;
    sh:property [ sh:path dcterms:license ; sh:nodeKind sh:IRI ; sh:class dcterms:RightsStatement ] .

shapes:CatalogMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset ;
    sh:property [ sh:path dcterms:publisher ; sh:node shapes:PublisherAgentReference ] ;
    sh:property [ sh:path dcterms:license ; sh:nodeKind sh:IRI ; sh:class dcterms:RightsStatement ] ;
    sh:property [ sh:path dcterms:conformsTo ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:language ; sh:nodeKind sh:IRI ] ;
    # Version labels are literals. dcterms:hasVersion links to a resource.
    sh:property [ sh:path dcat:version ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:hasVersion ; sh:nodeKind sh:BlankNodeOrIRI ] .

shapes:DatasetShape a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dcterms:isPartOf ; sh:class dcat:Catalog ] ;
    sh:property [ sh:path dcat:distribution ; sh:class dcat:Distribution ] .

shapes:ResourceMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset, dcat:Distribution, hds:Report ;
    sh:property shapes:Description ;
    sh:property [ sh:path prov:generatedAtTime ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:identifier ; sh:datatype xsd:anyURI ] ;
    sh:property [ sh:path dcterms:title ; sh:node shapes:TextLiteral ] ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ] .

shapes:LabelShape a sh:NodeShape ;
    sh:targetClass hds:Incident, hds:Report, dcterms:Location, skos:Concept,
        prov:Agent, dcat:Catalog, dcat:Dataset, dcat:Distribution ;
    sh:property [ sh:path rdfs:label ; sh:node shapes:TextLiteral ] .

shapes:Description a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:node shapes:TextLiteral .

shapes:TextLiteral a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:string ]
        [ sh:datatype rdf:langString ]
    ) .

# Incident-domain SHACL validation
# Validate the incident-domain vocabulary in hds-cdm.ttl.
# Additional domains and translations are allowed.

hds:IncidentDomainSchemeShape a sh:NodeShape ;
    sh:targetNode hds:incidentDomainScheme ;
    sh:nodeKind sh:IRI ;
    sh:class skos:ConceptScheme ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "The incident-domain scheme needs a language-tagged title, with at most one title per language."@en
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "Descriptions must be language-tagged, with at most one description per language."@en
    ] ;
    sh:property [
        sh:path skos:hasTopConcept ;
        sh:minCount 1 ;
        sh:node hds:IncidentDomainConceptShape ;
        sh:message "Each top concept must be an IRI identifying a labelled concept in the incident-domain scheme."@en
    ] .

hds:IncidentDomainConceptShape a sh:NodeShape ;
    # Relationship targets also catch concepts whose rdf:type was omitted.
    sh:targetClass skos:Concept ;
    sh:targetSubjectsOf skos:inScheme ;
    sh:targetObjectsOf skos:hasTopConcept ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property [
        sh:path hds:applicableProperty ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rdf:Property ] [ sh:class owl:DatatypeProperty ]
            [ sh:class owl:ObjectProperty ] [ sh:class owl:AnnotationProperty ] ) ;
        sh:message "Applicable properties must be IRIs with an explicit RDF or OWL property declaration in the data graph."@en
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "Each incident domain needs a language-tagged preferred label, with at most one preferred label per language."@en
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "Descriptions must be language-tagged, with at most one description per language."@en
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:nodeKind sh:IRI ;
        sh:hasValue hds:incidentDomainScheme ;
        sh:message "Each incident domain must belong to hds:incidentDomainScheme."@en
    ] .


# ---------------------------------------------------------------------------
# SafeVoice additions: topic, record, controlled incident terms, journey, groups.
# The controlled terms in sh:in are the values of the SafeVoice input form (config/UI_drop_downs.csv).
# ---------------------------------------------------------------------------
shapes:IncidentRecordingShape a sh:NodeShape ;
    sh:targetClass hds:Incident ;
    sh:property [ sh:path hds:informationSource ; sh:class hds:InformationSource ] ;
    sh:property [ sh:path hds:incidentCharacteristic ; sh:class hds:IncidentCharacteristic ] ;
    sh:property [ sh:path hds:victimDescriptor ; sh:class hds:VictimDescriptor ] ;
    sh:property [ sh:path hds:victimLocation ; sh:class dcterms:Location ] ;
    sh:property [ sh:path hds:hasJourney ; sh:class hds:Journey ] ;
    sh:property [
        sh:path hds:reportedAt ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:date ] ) ;
        sh:message "The reported time is a date or a date and time."@en
    ] .

shapes:TopicShape a sh:NodeShape ;
    sh:targetClass hds:Topic ;
    sh:property [ sh:path dcterms:title ; sh:node shapes:TextLiteral ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:hasRecord ; sh:class hds:Record ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:node shapes:TextLiteral ;
        sh:pattern "^\\s*(\\S+\\s+){0,249}(\\S+\\s*)?$" ;
        sh:message "A topic description has at most 250 words."@en
    ] .

shapes:RecordShape a sh:NodeShape ;
    sh:targetClass hds:Record ;
    sh:property [ sh:path hds:recordNumber ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:recordVersion ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:author ; sh:class prov:Agent ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:describesIncident ; sh:class hds:Incident ] ;
    sh:property [ sh:path dcterms:created ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] .

shapes:InformationSourceShape a sh:NodeShape ;
    sh:targetClass hds:InformationSource ;
    sh:property [ sh:path hds:sourceType ; sh:datatype xsd:string ; sh:in ( "WhatsApp" "Phone conversation" "Personal meeting" "From another source" "Other" ) ];
    sh:property shapes:Description .

shapes:IncidentCharacteristicShape a sh:NodeShape ;
    sh:targetClass hds:IncidentCharacteristic ;
    sh:property [ sh:path hds:characteristic ; sh:datatype xsd:string ; sh:in ( "Refugee movement" "Abduction" "Ransom payment" "Human Trafficking" "Abuse" "Torture" "Captivity" "Extortion" "Forced transportation" "Disappearance" "Emergency situation" "Other" ) ];
    sh:property shapes:Description .

shapes:VictimDescriptorShape a sh:NodeShape ;
    sh:targetClass hds:VictimDescriptor ;
    sh:property [ sh:path hds:victimCategory ; sh:datatype xsd:string ; sh:in ( "Refugee" "Migrant" "Family" "With adolescent child(ren)" "With young child(ren)" "With infant(s)" "With elderly" ) ];
    sh:property shapes:Description .

shapes:ShelterShape a sh:NodeShape ;
    sh:targetClass dcterms:Location ;
    sh:property [ sh:path hds:shelterType ; sh:datatype xsd:string ; sh:in ( "Refugee camp" "IDP camp" "Police station" "Prison" "Private house" "Hospital" "Warehouse" "Other" ) ];
    sh:property [ sh:path hds:shelterDescription ; sh:node shapes:TextLiteral ] .

shapes:JourneyShape a sh:NodeShape ;
    sh:targetClass hds:Journey ;
    sh:property [ sh:path hds:journeyStart ; sh:class dcterms:Location ] ;
    sh:property [ sh:path hds:journeyEnd ; sh:class dcterms:Location ] ;
    sh:property shapes:Description .

shapes:VictimGroupShape a sh:NodeShape ;
    sh:targetClass hds:VictimGroup ;
    sh:property [ sh:path hds:groupSize ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:maleCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:femaleCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:otherGenderCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path hds:ageRange ; sh:datatype xsd:string ; sh:in ( "Under 5" "5-11" "12-17" "18-24" "25-39" "40-59" "60 and over" ) ];
    sh:property [ sh:path hds:nationality ; sh:datatype xsd:string ] ;
    sh:property shapes:Description .

shapes:PerpetratorShape a sh:NodeShape ;
    sh:targetClass hds:Perpetrator ;
    sh:property [ sh:path dcterms:isPartOf ; sh:class hds:PerpetratorGroup ] ;
    sh:property [ sh:path hds:perpetratorCategory ; sh:datatype xsd:string ; sh:in ( "Human trafficking agent(s)" "NGOs" "Transporters" "Police" "Other" ) ];
    sh:property [ sh:path hds:nationality ; sh:datatype xsd:string ] .

shapes:PerpetratorGroupShape a sh:NodeShape ;
    sh:targetClass hds:PerpetratorGroup ;
    sh:property shapes:Description .

# ---------------------------------------------------------------------------
# Geographic description of a location (SafeVoice proposal). Reuses Schema.org terms; all optional.
# Used for the victim location and for the start and end of a journey.
# ---------------------------------------------------------------------------
shapes:LocationGeographyShape a sh:NodeShape ;
    sh:targetClass dcterms:Location ;
    sh:property [ sh:path schema:addressCountry ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:addressRegion ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:addressLocality ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:streetAddress ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path schema:latitude ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:float ] [ sh:datatype xsd:double ] [ sh:datatype xsd:decimal ] ) ;
        sh:minInclusive -90 ; sh:maxInclusive 90
    ] ;
    sh:property [
        sh:path schema:longitude ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:float ] [ sh:datatype xsd:double ] [ sh:datatype xsd:decimal ] ) ;
        sh:minInclusive -180 ; sh:maxInclusive 180
    ] .
