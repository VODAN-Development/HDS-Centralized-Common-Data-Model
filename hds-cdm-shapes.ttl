@prefix hds: <https://vodan-development.github.io/HDS-Centralized-Common-Data-Model/hds-cdm.ttl#> .
@prefix hdsDomain: <https://vodan-development.github.io/HDS-Centralized-Common-Data-Model/incident-domains.ttl#> .
@prefix shapes: <https://github.com/VODAN-Development/HDS-Centralized-Common-Data-Model#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL expresses the profile's expected value types. All properties are 
# currently optional because no minimum cardinalities are expressed.

shapes:IncidentShape a sh:NodeShape ;
    sh:targetClass hds:Incident ;
    sh:node shapes:PoliticalIncidentShape, shapes:CasualtyIncidentShape,
        shapes:MilitaryIncidentShape ;
    sh:property [
        sh:path hds:involves ;
        sh:or ( [ sh:class prov:Agent ] [ sh:class schema:Person ] )
    ] ;
    sh:property [
        sh:path schema:location ;
        sh:class dcterms:Location ;
        sh:description "A migration route may locate a migration or human trafficking incident. An IDP or refugee camp may locate a human rights abuse or humanitarian incident."@en
    ] ;
    # Load incident-domains.ttl with the data for the class and scheme checks.
    sh:property [
        sh:path hds:incidentDomain ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:hasValue hdsDomain:IncidentDomains
        ]
    ] ;
    sh:property [ sh:path hds:reportedBy ; sh:class prov:Agent ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:or ( [ sh:class hds:Report ] [ sh:class dcat:Dataset ] )
    ] ;
    sh:property [ sh:path schema:startDate ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:endDate ; sh:datatype xsd:dateTime ] ;
    sh:property shapes:Description ;
    sh:property [ sh:path hds:confidentiality ; sh:datatype xsd:string ] ;
    sh:property [ sh:path hds:victimCount ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path hds:status ; sh:datatype xsd:string ] .

shapes:AgentShape a sh:NodeShape ;
    sh:targetClass prov:Agent, foaf:Agent, schema:Person ;
    sh:property [ sh:path hds:actorType ; sh:datatype xsd:string ] ;
    sh:property [ sh:path foaf:name ; sh:node shapes:TextLiteral ] .

shapes:CampShape a sh:NodeShape ;
    sh:targetClass hds:Camp ;
    sh:property [ sh:path schema:location ; sh:class dcterms:Location ] .

# These reusable shapes check field types on every incident, regardless of tag.
# Applicable-property annotations describe relevance, not permission or requiredness.
shapes:PoliticalIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:outcome ; sh:datatype xsd:string ] .

shapes:CasualtyIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:casualties ; sh:datatype xsd:integer ] .

shapes:MilitaryIncidentShape a sh:NodeShape ;
    sh:property [ sh:path hds:weaponsUsed ; sh:datatype xsd:string ] .

# Role names remain provisional; no publisher/owner/consent-giver equivalence.
shapes:ConsentShape a sh:NodeShape ;
    sh:targetClass dpv:Consent ;
    sh:property [ sh:path hds:hasDataOwner ; sh:class prov:Agent ] ;
    sh:property [ sh:path hds:hasDataUser ; sh:class prov:Agent ] ;
    sh:property [ sh:path dpv:hasPurpose ; sh:class dpv:Purpose ] ;
    sh:property [ sh:path dcterms:publisher ; sh:node shapes:AgentReference ] ;
    sh:property [ sh:path dcterms:accessRights ; sh:class dcterms:RightsStatement ] ;
    sh:property shapes:Restriction .

# Legacy restriction placement remains accepted while governance is refined.
shapes:DataOwnerShape a sh:NodeShape ;
    sh:targetObjectsOf hds:hasDataOwner ;
    sh:property shapes:Restriction .

shapes:Restriction a sh:PropertyShape ;
    sh:path hds:hasRestriction ;
    sh:description "Reference a documented usage restriction. DUO is supported when appropriate but is not mandatory."@en ;
    sh:nodeKind sh:IRI .

shapes:AgentReference a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:or ( [ sh:class prov:Agent ] [ sh:class foaf:Agent ]
        [ sh:class schema:Person ] [ sh:class schema:Organization ] ) .

# Validate ODRL party values without treating them as generic HDS data users.
# Full ODRL policy structure requires a separate policy profile.
shapes:PolicyPartyShape a sh:NodeShape ;
    sh:targetSubjectsOf odrl:assignee, odrl:assigner ;
    sh:property [ sh:path odrl:assignee ; sh:class odrl:Party ] ;
    sh:property [ sh:path odrl:assigner ; sh:class odrl:Party ] .

# Dataset access status, license and policy are independent relationships.
shapes:RightsMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset, dcat:Distribution,
        dcat:DataService, dpv:Consent ;
    sh:property [ sh:path dcterms:license ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:accessRights ; sh:class dcterms:RightsStatement ] ;
    sh:property [ sh:path odrl:hasPolicy ; sh:class odrl:Policy ] ;
    sh:property [ sh:path dpv:hasPurpose ; sh:class dpv:Purpose ] ;
    sh:property shapes:Restriction .

shapes:ReportShape a sh:NodeShape ;
    sh:targetClass hds:Report ;
    sh:property [ sh:path dcterms:subject ; sh:class hds:Incident ] .

shapes:CatalogMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset ;
    sh:property [ sh:path dcterms:publisher ; sh:node shapes:AgentReference ] ;
    sh:property [ sh:path dcterms:accessRights ; sh:class dcterms:RightsStatement ] ;
    sh:property [ sh:path dcterms:license ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:conformsTo ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dcterms:language ; sh:nodeKind sh:IRI ] ;
    # Version labels are literals. dcterms:hasVersion links to a resource.
    sh:property [ sh:path dcat:version ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:hasVersion ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path dcat:contactPoint ; sh:class vcard:Kind ] .

shapes:CatalogShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [ sh:path dcat:service ; sh:class dcat:DataService ] .

shapes:DatasetShape a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [ sh:path dcterms:isPartOf ; sh:class dcat:Catalog ] ;
    sh:property [ sh:path dcat:distribution ; sh:class dcat:Distribution ] .

# A SPARQL endpoint is a data service. Describe it on a catalog via
# dcat:service or link it from a distribution via dcat:accessService.
shapes:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [ sh:path dcat:accessService ; sh:class dcat:DataService ] .

shapes:DataServiceShape a sh:NodeShape ;
    sh:targetClass dcat:DataService ;
    sh:property [ sh:path dcat:servesDataset ; sh:class dcat:Dataset ] ;
    sh:property [ sh:path dcat:endpointURL ; sh:nodeKind sh:IRI ] .

shapes:ResourceMetadataShape a sh:NodeShape ;
    sh:targetClass dcat:Catalog, dcat:Dataset, dcat:Distribution, dcat:DataService, hds:Report ;
    sh:property shapes:Description ;
    sh:property [ sh:path prov:generatedAtTime ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path schema:identifier ; sh:datatype xsd:anyURI ] ;
    sh:property [ sh:path dcterms:title ; sh:node shapes:TextLiteral ] ;
    sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ] .

shapes:LabelShape a sh:NodeShape ;
    sh:targetClass hds:Incident, hds:Report, dcterms:Location, skos:Concept,
        prov:Agent, foaf:Agent, dcat:Catalog, dcat:Dataset, dcat:Distribution ;
    sh:property [ sh:path rdfs:label ; sh:node shapes:TextLiteral ] .

shapes:Description a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:node shapes:TextLiteral .

shapes:TextLiteral a sh:NodeShape ;
    sh:or (
        [ sh:datatype xsd:string ]
        [ sh:datatype rdf:langString ]
    ) .
